#!/bin/sh
# ============================================================
# novi-agentd service — run script
#
# RFC 0032. `s6-ipcserver` on a unix socket, running
# novi-agent-serve per connection, so a process that is NOT root can
# drive the declared verb list.
#
# Declared by `services.novi-agentd` and OFF BY DEFAULT, like every
# other service that opens a way in. Turning the agent interface on
# (`agent.enabled`) and exposing it to non-root callers are separate
# decisions and stay separate keys -- the same argument RFC 0022 makes
# for `network.firewall.allow` not being derived from `services.sshd`.
# ============================================================

SOCKDIR=/run/novi/agent
SOCK="${SOCKDIR}/sock"

# THE DIRECTORY IS THE GATE, not the socket's own mode.
#
# A unix socket's permission bits are honoured by Linux, but the
# portable and legible gate is the directory: 0750 root:agent means a
# process cannot even reach the path unless it is in the group, and
# there is one thing to read rather than two that must agree.
# Membership of `agent` IS the grant (RFC 0032) -- deliberately unix's
# own mechanism rather than a fourth policy key.
if ! grep -q '^agent:' /etc/group 2>/dev/null; then
    echo "novi-agentd: no 'agent' group in /etc/group -- this base image predates RFC 0032" >&2
    exit 1
fi

command -v novi-agent-serve >/dev/null 2>&1 || {
    echo "novi-agentd: novi-agent-serve is missing" >&2
    exit 1
}

mkdir -p "$SOCKDIR"
chown root:agent "$SOCKDIR" 2>/dev/null || {
    echo "novi-agentd: could not chown ${SOCKDIR} to root:agent" >&2
    exit 1
}
# 2750, NOT 0750, AND THE SETGID BIT IS THE WHOLE FEATURE.
#
# s6-ipcserver binds the socket as root, so it is created root:root --
# and `-a 0660` on a root:root socket gives the `agent` group NOTHING.
# The directory was 0750 root:agent and correct, the socket mode was
# 0660 and correct, and the two together denied every member of the
# group the socket exists for. Verified the wrong way round first:
# `Permission denied` from s6-ipcclient as a user in `agent`, on a
# service reporting up and ready.
#
# A setgid directory hands its own group to everything created inside
# it, sockets included (bind() goes through vfs_mknod like any other
# node), so the socket comes out root:agent and the 0660 means what it
# says.
chmod 2750 "$SOCKDIR"

# A socket left behind by a previous run makes bind() fail with
# EADDRINUSE, which reads as "something else is listening" when
# nothing is.
rm -f "$SOCK"

# -1  notify readiness on FD 1 once the socket is bound -- and the
#     `notification-fd` file beside this one says 1 for that reason,
#     not the 3 every other service here uses. s6-ipcserver's flag
#     names the descriptor; declaring 3 would leave s6 watching a
#     descriptor nothing ever writes to, so the service would never
#     come up ready and `s6-rc -u change` would wait out timeout-up
#     on every start. That is RFC 0004's `s6-log -d3` bug exactly,
#     with the mismatch on the other side. THE SOCKET
#     EXISTING is the precondition anything else races on, and unlike
#     sshd's "is it listening?" this one is knowable -- s6-ipcserver
#     binds before it signals. `timeout-up` beside this file is the
#     other half: a longrun that declares readiness and never signals
#     makes `s6-rc -u change` wait forever (RFC 0022 learned that).
# -p  fill IPCREMOTEEUID/EGID from SO_PEERCRED. WITHOUT THIS the
#     handler cannot name the caller and refuses every request, which
#     is the right failure but a confusing one -- so it is here, and
#     novi-agent-serve says so if it is ever missing.
# -c  a ceiling on concurrent connections. An agent that opens sockets
#     and never speaks would otherwise hold slots indefinitely; this
#     is the server's problem to bound and it does, rather than every
#     handler racing its own timeout.
# -a  the socket's own mode. This is the second gate rather than a
#     decoration, and it only works because of the setgid bit above:
#     0660 on a root:root socket would exclude the very group the
#     directory admits.
exec s6-ipcserver -1 -p -c 8 -a 0660 "$SOCK" novi-agent-serve
