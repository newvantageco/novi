#!/bin/sh
# ============================================================
# network service — run script
#
# DHCP on one interface, supervised by s6. udhcpc runs in the
# foreground (-f) so s6 supervises the real process rather than a
# daemonized orphan; the lease is applied by
# /usr/share/udhcpc/default.script.
#
# What this service is declared by: `network.dhcp` in
# /etc/novi/system.conf (RFC 0002), NOT a `services.network` key.
# Two keys controlling one service is exactly the split-brain this
# project exists to avoid, so the network domain owns it and the
# services domain does not mention it.
# ============================================================

RUN_DIR=/run/novi
mkdir -p "$RUN_DIR"

# The declared interface. `auto` (the default) means "the first real
# one", which is the right answer on every single-NIC machine and an
# explicit name is how you say otherwise.
#
# The spec is recorded in /run so `novi-state diff` can tell that the
# running service was started with a different one than the document
# now declares -- that is what makes changing it show up as drift
# instead of silently doing nothing until the next reboot.
IFSPEC="$(novi-state get network.interface 2>/dev/null || printf 'auto')"
[ -n "$IFSPEC" ] || IFSPEC=auto
printf '%s\n' "$IFSPEC" > "$RUN_DIR/network.interface"

DNSSPEC="$(novi-state get network.dns 2>/dev/null || printf 'auto')"
[ -n "$DNSSPEC" ] || DNSSPEC=auto
printf '%s\n' "$DNSSPEC" > "$RUN_DIR/network.dns"

# How this interface gets its address (RFC 0033). `dhcp` -- the default,
# and what an absent key means -- is a lease; anything else is a CIDR
# this service configures itself.
#
# The switch is a MODE rather than a second service, because "which
# interface" and "bring the network up" are already answered here and a
# static machine needs both answers to be the same ones. What it costs
# is that `network.dhcp` now names the service rather than the
# protocol: it is the switch that turns this on, and `network.address`
# is what decides whether a DHCP client is any part of it.
ADDRSPEC="$(novi-state get network.address 2>/dev/null || printf 'dhcp')"
[ -n "$ADDRSPEC" ] || ADDRSPEC=dhcp
printf '%s\n' "$ADDRSPEC" > "$RUN_DIR/network.address"

GWSPEC="$(novi-state get network.gateway 2>/dev/null || printf 'auto')"
[ -n "$GWSPEC" ] || GWSPEC=auto
printf '%s\n' "$GWSPEC" > "$RUN_DIR/network.gateway"

# Readiness, declared to s6 via ./notification-fd. Everything s6-rc
# needs to consider this service usable -- the recorded spec that
# `novi-state diff` reads -- exists as of this line, and everything
# after it (driver probing, waiting for a NIC, the lease itself) can
# take arbitrarily long.
#
# This is not a nicety. `s6-rc change` returns as soon as a longrun is
# *started* unless the service declares readiness, and rc.init runs
# boot convergence the moment it returns. Without this, boot
# convergence raced the lines above, observed network.interface as
# "unknown", called it drift, and restarted this very service --
# burning a generation on every single boot for no reason. Confirmed
# live: a fresh boot with nothing touched came up at generation 0001.
echo >&3

# NIC drivers this kernel builds as modules. The built-in ones
# (e1000e, r8169 -- see kernel/config-x86_64) need no help; virtio_net
# is =m and nothing else loads it, so a QEMU guest has no interface at
# all without this. Same pattern, and same reason, as novi-shell's
# `modprobe virtio_gpu`. Roadmap §4's hardware-detection oneshot is the
# real long-term answer to "load whatever this machine needs".
# Dependencies first, by name, before the drivers that need them.
# `modprobe virtio_net` alone left eight "virtio_net: Unknown symbol
# net_dim / net_failover_create (err -2)" lines in the kernel log on
# every boot -- two racing attempts failing before a third succeeded --
# even though modules.dep lists the dependencies correctly and the
# driver did end up loaded and working. Loading them explicitly first
# removes the race outright, and costs nothing when they are already in
# (modprobe is a no-op then).
for m in dimlib failover net_failover mdio; do
    modprobe "$m" 2>/dev/null || true
done
for m in virtio_net e1000 e1000e r8169 igb ixgbe r8152 cdc_ether; do
    modprobe "$m" 2>/dev/null || true
done

# Loopback. Nothing else brings it up, and plenty of software assumes
# 127.0.0.1 resolves to something before any external network exists.
ip link set lo up 2>/dev/null || true

# Wired first, wireless second.
#
# A laptop has both, and udhcpc runs on exactly one interface here, so
# something has to choose. Wired wins: it is the one that works without
# credentials, and on a machine with a cable plugged in it is what the
# person plugging it in meant. `network.interface = wlan0` overrides.
#
# Per-interface DHCP -- a lease on every link that has one -- is the
# right long-term answer and a bigger change than this service; RFC
# 0009 says so rather than pretending this is finished.
pick_interface() {
    pick_interface_pass wired || pick_interface_pass wireless
}

pick_interface_pass() {
    want="$1"
    for d in /sys/class/net/*; do
        [ -d "$d" ] || continue
        n="${d##*/}"
        [ "$n" = "lo" ] && continue

        # A wireless device is one the kernel gave a phy80211 link, not
        # one whose name starts with "wl". Naming is a convention;
        # /sys/class/net/*/phy80211 is the kernel saying what the
        # device is.
        if [ -d "$d/phy80211" ]; then
            [ "$want" = "wireless" ] || continue
        else
            [ "$want" = "wired" ] || continue
        fi

        # ARPHRD_ETHER (1) only. Skipping just "lo" is not enough: a
        # kernel with CONFIG_IPV6_SIT creates `sit0`, an IPv6-in-IPv4
        # tunnel pseudo-device, at boot -- and it sorts before eth0.
        # Confirmed live on a machine with no NIC attached at all:
        # "network: using sit0", then udhcpc broadcasting DISCOVER
        # forever down a tunnel that has no link and never will.
        # Anything that is not an Ethernet-like device (tunnels, gre,
        # teql, dummy) has the same problem.
        [ -r "$d/type" ] || continue
        [ "$(cat "$d/type")" = "1" ] || continue

        printf '%s\n' "$n"
        return 0
    done
    return 1
}

# Wait rather than exit: a NIC driver can still be probing when s6
# starts this, and a service that exits gets restarted by s6 in a tight
# loop that fills the log without ever getting further. Waiting here is
# quiet and ends the moment the interface appears.
IFACE=""
n=0
while [ -z "$IFACE" ]; do
    if [ "$IFSPEC" = "auto" ]; then
        IFACE="$(pick_interface || true)"
    elif [ -d "/sys/class/net/${IFSPEC}" ]; then
        IFACE="$IFSPEC"
    fi
    [ -n "$IFACE" ] && break
    n=$((n + 1))
    [ $((n % 30)) -eq 1 ] && \
        echo "network: waiting for interface (${IFSPEC}) ..." >&2
    sleep 2
done

echo "network: using ${IFACE} (declared: ${IFSPEC}, addr: ${ADDRSPEC}, dns: ${DNSSPEC})" >&2
printf '%s\n' "$IFACE" > "$RUN_DIR/network.device"
ip link set "$IFACE" up 2>/dev/null || true

if [ "$ADDRSPEC" = "dhcp" ]; then
    # -f: foreground, so s6 supervises udhcpc itself.
    # -b would background on lease failure -- exactly wrong under a
    # supervisor. -R releases the lease when the service is brought down.
    exec udhcpc -f -R -i "$IFACE" -s /usr/share/udhcpc/default.script
fi

# ── Static addressing (RFC 0033) ────────────────────────────────────
#
# The value is validated by `novi-state apply` before it can ever get
# here, but this service is also started at boot from a file somebody
# may have hand-edited, so it is checked again. Refusing loudly beats
# handing `ip` a malformed argument and leaving a machine with no
# address and an error two layers down.
case "$ADDRSPEC" in
    */*) : ;;
    *)   echo "network: network.address = '${ADDRSPEC}' is not 'dhcp' and not a CIDR (a.b.c.d/len)" >&2
         exit 1 ;;
esac

# Flush first. Restarting this service after an address change would
# otherwise LEAVE THE OLD ADDRESS on the interface beside the new one
# -- the machine answers on both, `ip addr` disagrees with the
# document, and the drift the change was meant to fix is still there
# under a second address. Same reason the lease script flushes.
ip -4 addr flush dev "$IFACE" 2>/dev/null || true
ip -4 route flush dev "$IFACE" 2>/dev/null || true

ip -4 addr add "$ADDRSPEC" dev "$IFACE" || {
    echo "network: could not set ${ADDRSPEC} on ${IFACE}" >&2
    exit 1
}

case "$GWSPEC" in
    auto|none|'')
        # No default route, which is a legitimate configuration -- a
        # machine on an isolated segment has nowhere for one to point.
        # Said out loud because "the address is up and nothing routes"
        # is otherwise diagnosed from the outside in.
        echo "network: no default route (network.gateway = ${GWSPEC:-auto})" >&2
        ;;
    *)
        ip -4 route add default via "$GWSPEC" dev "$IFACE" || {
            echo "network: could not route via ${GWSPEC} on ${IFACE}" >&2
            exit 1
        }
        ;;
esac

# The resolver, through the one writer both paths share. There is no
# lease here, so `network.dns = auto` resolves to no servers at all --
# a real and easily-made mistake (auto is the shipped default), so it
# is reported rather than left as a machine that has an address and
# cannot look anything up.
if [ -f /usr/lib/novi/resolv.sh ]; then
    # shellcheck source=/dev/null
    . /usr/lib/novi/resolv.sh
    novi_write_resolv "the network service for ${IFACE}" "" "" ||
        echo "network: network.dns is '${DNSSPEC}' and there is no lease to learn from -- no resolver configured" >&2
else
    echo "network: /usr/lib/novi/resolv.sh is missing; no resolver written" >&2
fi

printf '%s\n' "${ADDRSPEC%%/*}" > "$RUN_DIR/network.ip"
echo "network: ${IFACE} = ${ADDRSPEC} static (gw ${GWSPEC})" >&2

# NOTHING TO SUPERVISE, AND THAT IS THE POINT. A static address is held
# by the kernel, not by a daemon; there is no client to keep alive and
# no lease to renew. But s6 supervises a PROCESS, so a longrun whose
# run script returns is a longrun s6 restarts forever.
#
# `sleep infinity` is one nanosleep and zero wakeups -- deliberately
# not `tail -f /dev/null`, which busybox implements by polling every
# second, forever, for a file that will never change. The process
# existing is what keeps `services` and `ip addr` agreeing about
# whether this configuration is live, and stopping the service is what
# runs ./finish to take the address back off.
exec sleep infinity
