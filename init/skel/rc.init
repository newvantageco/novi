#!/bin/sh -e
# ============================================================
# rc.init -- s6-linux-init stage 2 entry point
#
# By the time this runs, s6-linux-init has already mounted the
# early virtual filesystems, exec'd into s6-svscan on /run/service,
# and that svscan has brought up the fixed run-image services
# (catch-all logger, runleveld, shutdownd). This script's job is to
# bring up everything else via s6-rc, then hand off to the runlevel
# script s6-linux-init-maker generated alongside it.
# ============================================================

rl="$1"
shift

### 1. Early one-time preparation
test -r /etc/hostname && hostname -F /etc/hostname

# POSIX shared memory (shm_open(3), used by musl's libc and by every
# Wayland client/compositor to share keymaps and buffers) is backed by
# a tmpfs at /dev/shm on Linux -- there is no other kernel-native
# shm_open path. devtmpfs at /dev (mounted earlier by s6-linux-init)
# does NOT create this on its own. Confirmed live: without it,
# novi-shell logged "Failed to allocate shm file for keymap" for every
# input device wlr_keyboard tried to hand a keymap to (non-fatal to
# the compositor itself, but would break keymap delivery to any real
# Wayland client).
mkdir -p /dev/shm
mountpoint -q /dev/shm || mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm

### 2. Start the s6-rc-managed services into the already-running
### scandir (/run/service, seeded by s6-linux-init from run-image).
s6-rc-init -c /etc/s6-rc/compiled -l /run/s6-rc /run/service

### 3. Bring the compiled "default" bundle up (or whatever runlevel
### was requested on the kernel command line -- see scripts/runlevel).
###
### Called rather than exec'd (it used to be exec'd) so that step 4 can
### run after it. Nothing is lost by that: `s6-rc change` exits once
### the transition finishes, so rc.init already returned here at the
### end of boot -- the exec was only saving one process.
/etc/s6-linux-init/scripts/runlevel "$rl" ||
    echo 'rc.init: runlevel transition reported failure' 1>&2

### 4. Converge the declared system state (RFC 0002).
###
### /etc/novi/system.conf is the system's declared truth; this is what
### makes the machine BOOT INTO it rather than merely being pushable to
### it after login.
###
### It has to be here, after the transition, and not as an s6-rc
### oneshot inside the bundle -- which is where it was tried first and
### does not work. A oneshot runs *during* the transition, and a nested
### `s6-rc change` cannot proceed while that transition holds the live
### state lock. Confirmed live rather than reasoned about: the oneshot
### reported success, `novi-state-apply` showed up in `s6-rc -a list`,
### and the declared desktop never started -- while the very same
### `novi-state boot`, run by hand a moment later, brought it straight
### up.
###
### `novi-state boot` is already unfailable by construction (it honours
### novi.state=off on the kernel command line and always exits 0), but
### the guard and `|| true` stay anyway: this script runs under `-e` as
### PID 1's stage 2, and nothing about the system's *configuration*
### should ever be able to turn into a failed boot.
if command -v novi-state >/dev/null 2>&1; then
    novi-state boot || true
fi
