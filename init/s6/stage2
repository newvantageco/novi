#!/bin/execlineb -P
# ============================================================
# stage2 — Bring up services via s6-rc
# Runs after stage1 mounts are complete.
# ============================================================

# Set hostname
foreground { cat /etc/hostname }
foreground { hostname -F /etc/hostname }

# Seed /dev/urandom for early entropy
foreground { dd if=/dev/urandom of=/dev/null bs=1 count=1 2>/dev/null }

# Configure loopback network
foreground { ip link set lo up }
foreground { ip addr add 127.0.0.1/8 dev lo }

# Bring up the s6-rc compiled service database
# This starts all services in the "default" bundle
foreground { s6-rc-init -c /etc/s6-rc/compiled -l /run/s6-rc/live /run/s6-rc }
foreground { s6-rc -l /run/s6-rc/live change default }

# Drop into getty on tty1 (s6 supervises this automatically)
s6-svscan /run/s6-sv
