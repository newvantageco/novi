# /etc/novi/firewall.nft — the one ruleset Novi ships (RFC 0016).
#
# Loaded when `network.firewall = on` in /etc/novi/system.conf.
# `novi-state apply` runs `nft -f` on this file; `off` deletes the
# table. Nothing supervises it -- the kernel holds the ruleset, so
# there is no daemon, and boot convergence reloads it like any other
# declared state.
#
# This is repo content rather than something generated, for the same
# reason /etc/passwd and /etc/shadow are: it is policy, and policy
# should show up in a diff. Edit it if you need something else; it is a
# real file in nftables' real format, not a serialisation of a settings
# panel.
#
# The table is called `novi` on purpose. The observer asks the kernel
# whether a table by that name exists, so this ruleset can be turned on
# and off without touching -- or claiming -- anything else somebody has
# installed in another table.

table inet novi {
	chain input {
		type filter hook input priority filter; policy drop;

		# Replies to things we started, and the ICMP errors that
		# belong to them. This is what makes a default-drop input
		# policy usable at all.
		ct state established,related accept
		ct state invalid drop

		# Loopback is not the network.
		iif lo accept

		# ICMP is accepted, not dropped. A host that black-holes it
		# breaks path-MTU discovery for everyone talking to it and is
		# a worse neighbour than one that answers a ping. "Stealth" is
		# not a security property when the packets that reveal you are
		# the ones your own TCP needs.
		ip protocol icmp accept
		ip6 nexthdr ipv6-icmp accept

		# DHCP replies arrive before conntrack has anything to match:
		# udhcpc sends from 0.0.0.0:68 to 255.255.255.255:67, and the
		# reply is a broadcast that is not "related" to anything. On a
		# machine that gets its address by DHCP -- which is the
		# default -- leaving this out means the firewall comes up and
		# the lease never renews.
		udp dport 68 accept
		ip6 nexthdr udp udp dport 546 accept
	}

	# Nothing here forwards. If Novi ever routes for anything, that is
	# a deliberate change to this file, not a default.
	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	# No output chain, deliberately. A desktop that cannot make
	# connections is not usable, and a filter constraining processes
	# run by the user who can also edit the filter is theatre.
}
