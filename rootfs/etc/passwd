# /etc/passwd — Novi Linux
#
# name:password:uid:gid:gecos:home:shell
#
# The password field is always `x`: hashes live in /etc/shadow (0600),
# never here. This file is world-readable by design -- every getpwnam()
# on the system reads it -- and musl has no NSS, so it is the only
# place an account can be defined.
#
# Accounts declared in /etc/novi/system.conf (`users.<name>.shell`) are
# created and maintained here by `novi-state apply`. Hand-editing works
# too, exactly as with the rest of the system's configuration.
root:x:0:0:root:/root:/bin/sh
nobody:x:65534:65534:nobody:/:/bin/false
