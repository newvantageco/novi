#!/bin/sh
# udhcpc hook — Novi Linux
#
# BusyBox's DHCP client hands the lease to this script and does nothing
# with it itself; every address, route and resolver on a DHCP-configured
# Novi machine is applied from right here.
#
# $1 is the action. The lease arrives in the environment:
#   $interface $ip $subnet $mask $router $dns $domain $lease $serverid
#
# Two deliberate choices worth stating, because both are things a
# stock distro's copy of this script does and Novi should not:
#
#   * It never sets the hostname from DHCP. The hostname is declared in
#     /etc/novi/system.conf and converged by novi-state (RFC 0002).
#     Letting a DHCP server overwrite it would put a second, invisible
#     writer on a value the whole project promises has exactly one.
#   * It writes the resolver to /run, not /etc. A DHCP lease is runtime
#     state, not configuration -- /etc/novi/system.conf is where
#     configuration lives, and churning a file under /etc every lease
#     renewal would blur that line. /etc/resolv.conf is a symlink to
#     the file this writes (see build/18-network.sh).
#
# shellcheck disable=SC3043,SC2154
# SC3043: `local` is outside strict POSIX sh but supported by BusyBox
# ash, this repo's real /bin/sh -- same as packages/pkg and
# packages/novi-state already document.
# SC2154: $interface, $ip, $mask, $router, $dns, $domain and $lease are
# set by udhcpc in this script's environment, which shellcheck cannot
# see. They are the entire input.

RUN_DIR=/run/novi

# The resolver writer is shared with the network service's static path
# (RFC 0033): one file, one writer, one rule about which servers win.
# Guarded because `.` is a special builtin -- sourcing a file that is
# not there ends this script immediately, and a DHCP hook that dies
# silently is a machine with no address and no explanation.
NOVI_RESOLV_LIB=/usr/lib/novi/resolv.sh
if [ -f "$NOVI_RESOLV_LIB" ]; then
    # shellcheck source=/dev/null
    . "$NOVI_RESOLV_LIB"
else
    printf 'udhcpc: %s is missing; cannot write a resolver\n' \
        "$NOVI_RESOLV_LIB" >&2
    exit 1
fi

log() { printf 'udhcpc: %s\n' "$*" >&2; }

mkdir -p "$RUN_DIR"

flush_addresses() {
    ip -4 addr flush dev "$interface" 2>/dev/null || true
    ip -4 route flush dev "$interface" 2>/dev/null || true
}

case "$1" in
    deconfig)
        # Called before the first request, and on release. Bring the
        # link up but give it no address.
        ip link set "$interface" up 2>/dev/null || true
        flush_addresses
        ;;

    bound|renew)
        flush_addresses
        if [ -n "${mask:-}" ]; then
            ip -4 addr add "${ip}/${mask}" dev "$interface"
        else
            ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
        fi
        ip link set "$interface" up

        if [ -n "${router:-}" ]; then
            ip -4 route del default 2>/dev/null || true
            for r in $router; do
                ip -4 route add default via "$r" dev "$interface" 2>/dev/null || true
                break
            done
        fi

        novi_write_resolv "udhcpc for ${interface}" "${dns:-}" "${domain:-}" ||
            log "the lease named no DNS server and network.dns is auto"
        # The address actually held, which is a different question from
        # the address declared (that is /run/novi/network.address, the
        # spec this service started with). `novi-agent describe` reads
        # this one -- RFC 0033 gave it a reader; before that it was
        # written and never read by anything.
        printf '%s\n' "$ip" > "${RUN_DIR}/network.ip"
        log "$interface = $ip (lease ${lease:-?}s, gw ${router:-none})"
        ;;

    nak)
        log "server refused the lease on $interface"
        ;;

    leasefail)
        # No DHCP server answered. Leave the interface up and
        # unconfigured rather than tearing it down -- udhcpc keeps
        # retrying, and a link that is up is one a person can configure
        # by hand in the meantime.
        log "no DHCP offer on $interface"
        ;;
esac

exit 0
