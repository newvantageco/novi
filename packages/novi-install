#!/bin/sh
# novi-install — put the running Novi live system onto a disk.
#
# The live ISO runs entirely in RAM: a read-only squashfs with a tmpfs
# overlay on top, so every change is gone at the next power cycle. This
# turns that into a real machine -- a partitioned disk, a writable root
# filesystem, a bootloader in the MBR, and a system that remembers.
#
# The design constraint that shapes this whole script: the installed
# system has no build host to lean on. There is no grub-install here,
# because GRUB's tooling is a build-time dependency and Novi's rootfs is
# a static BusyBox. So `scripts/mkiso.sh` does the half of grub-install
# that needs those tools -- generating boot.img and a core.img with the
# prefix already baked in -- and stages the result in /novi-boot on the
# ISO. What is left for install time is placement: two `dd`s and a
# directory copy, all of which BusyBox can do. See
# docs/rfcs/0003-installation-and-persistence.md.
#
# Both firmware paths are supported (RFC 0008). The machine's own
# firmware decides which, and `--firmware` overrides it:
#
#   UEFI   GPT: a 512 MiB EFI System partition and an ext4 root.
#          novi-gpt writes the table (BusyBox fdisk cannot create a
#          GPT); a self-contained bootx64.efi goes on the ESP.
#   BIOS   MBR: one ext4 partition starting at sector 2048, with
#          boot.img in the MBR and core.img in the gap behind it.
#
# The root filesystem is real ext4 with a journal, made by e2fsprogs'
# mke2fs rather than BusyBox's -- an unclean shutdown replays a log
# instead of fscking the whole disk.
#
# Still true, and still worth stating: this wipes the target disk
# completely. There is no partial install, no dual-boot layout, and no
# undo.
#
# shellcheck disable=SC3043
# `local` is outside strict POSIX sh, which is what shellcheck's `sh`
# dialect checks -- but the real target is BusyBox ash, which supports
# it, exactly as packages/pkg and packages/novi-state already document.
set -eu

msg()  { printf '==> %s\n'    "$*" >&2; }
info() { printf '  -> %s\n'   "$*" >&2; }
warn() { printf 'WARN: %s\n'  "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "This operation requires root."
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
LIVE_DIR="${NOVI_LIVE_DIR:-/run/live}"       # ISO, bind-mounted by /init
MNT="${NOVI_INSTALL_MNT:-/mnt/novi-target}"
ROOT_LABEL="${NOVI_ROOT_LABEL:-NOVI_ROOT}"
ESP_LABEL="${NOVI_ESP_LABEL:-NOVI_ESP}"
ROOT_FSTYPE="ext4"

TARGET_DISK=""
NEW_HOSTNAME=""
FIRMWARE=""
ESP_MIB=512
ROOT_PART=""
ESP_PART=""
ESP_MOUNTED=0

# Full-disk encryption (RFC 0018).
#
#   ENCRYPT       --encrypt was given
#   LUKS_PART     the partition holding the container
#   ROOT_DEV      what actually gets a filesystem and gets mounted:
#                 the mapper device when encrypting, the partition
#                 otherwise. Everything downstream of format uses this
#                 and never ROOT_PART, so exactly one line decides
#                 whether an install is encrypted.
#   BOOT_PART     an unencrypted /boot, BIOS only -- see the RFC's
#                 layout table. Empty on every other install.
ENCRYPT=0
LUKS_PART=""
LUKS_NAME="novi-root"
LUKS_UUID=""
LUKS_OPENED=0
LUKS_PASSPHRASE=""
ROOT_DEV=""
BOOT_PART=""
BOOT_LABEL="${NOVI_BOOT_LABEL:-NOVI_BOOT}"
BOOT_MIB=512
BOOT_MOUNTED=0
PROFILE="desktop"
TARGET_MIRROR=""
NEW_USER=""
NEW_USER_GROUPS="wheel,users,video,input,audio,seat"
NEW_USER_SHELL="/bin/sh"
NO_PASSWORD=0
SET_ROOT_PASSWORD=0
ASSUME_YES=0
WITH_BOOTLOADER=1
MOUNTED=0
PASSWORD=""

usage() {
    cat <<'USAGE'
novi-install — install Novi Linux onto a disk

Usage:
  novi-install list                     show candidate target disks
  novi-install install --disk DEV [options]

Options:
  --disk DEV          target disk, e.g. /dev/sda or /dev/vda (REQUIRED)
  --hostname NAME     hostname for the installed system (default: keep)
  --firmware F        uefi or bios. Default: whatever this machine
                      booted with, which is almost always what you want
                      -- installing the other one produces a disk this
                      machine cannot boot.
  --esp-mib N         size of the EFI System partition (default 512)
  --encrypt           LUKS2-encrypt the root filesystem (prompts for a
                      passphrase). The kernel, the initramfs and the
                      boot menu stay UNENCRYPTED -- something has to be
                      readable before the initramfs can ask for the
                      passphrase. This protects data at rest against
                      someone who takes the disk; it is not protection
                      against someone who can write to it and hand it
                      back. See RFC 0018.
  --profile P         desktop (default) or console. `desktop` installs the
                      desktop packages from the repository on this medium
                      and declares them, so the installed machine boots
                      into a graphical session with no network involved.
  --mirror URL        package mirror for the installed system. Without
                      one, the installed system has no mirror configured
                      (this medium's repository will not be there after
                      you remove it).
  --user NAME         create a login account (prompts for its password)
  --user-groups LIST  its supplementary groups
                      (default: wheel,users,video,input,audio,seat)
  --user-shell PATH   its login shell (default: /bin/sh)
  --no-password       create the account locked instead of prompting
  --set-root-password prompt for a root password too
  --no-bootloader     partition, format and copy, but write no MBR
  -y, --yes           do not ask for confirmation (the disk IS erased)
  -h, --help          this text

The target disk is erased completely. There is no partial install, no
dual-boot layout, and no undo.
USAGE
}

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
cleanup() {
    if [ "$MOUNTED" -eq 1 ]; then
        # The repository bind mount lives under $MNT, so it has to come
        # off first or the unmount below fails with EBUSY and leaves the
        # target filesystem mounted after a failed install.
        umount "$MNT/mnt/novi-repo" 2>/dev/null || true
        # The ESP is mounted inside the target, so it comes off before
        # the root does or the unmount below fails with EBUSY.
        umount "$MNT/boot/efi" 2>/dev/null || true
        ESP_MOUNTED=0
        umount "$MNT/boot" 2>/dev/null || true
        BOOT_MOUNTED=0
        umount "$MNT" 2>/dev/null || true
        MOUNTED=0
    fi
    # After the filesystems, never before: the mapper device cannot be
    # closed while something is mounted on it, and a failed install
    # that leaves /dev/mapper/novi-root open makes the next attempt
    # fail with "device already exists" for no visible reason.
    if [ "$LUKS_OPENED" -eq 1 ]; then
        cryptsetup close "$LUKS_NAME" 2>/dev/null || true
        LUKS_OPENED=0
    fi
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Disk discovery
# ---------------------------------------------------------------------------

# The device the live media itself is on. Installing onto it would pull
# the floor out from under the running system halfway through the copy,
# so it is excluded from the candidate list and refused by name.
live_device() {
    local dev
    dev="$(awk -v d="$LIVE_DIR" '$2 == d { print $1; exit }' /proc/mounts 2>/dev/null || true)"
    [ -n "$dev" ] || return 0
    # /run/live is a bind mount of the ISO mount, so /proc/mounts names
    # the real backing device for it either way.
    printf '%s\n' "$dev"
}

# Whole disks only. /sys/block also lists loop, ram, zram, device-mapper
# and md nodes, none of which anyone means by "install to a disk", plus
# sr* (the optical drive the ISO is likely in).
list_disks() {
    local d name
    for d in /sys/block/*; do
        [ -d "$d" ] || continue
        name="${d##*/}"
        case "$name" in
            loop*|ram*|zram*|dm-*|md*|sr*|fd*) continue ;;
        esac
        printf '%s\n' "$name"
    done
}

disk_size_human() {
    local name="$1" sectors
    sectors="$(cat "/sys/block/${name}/size" 2>/dev/null || echo 0)"
    # /sys/block/*/size is always in 512-byte sectors regardless of the
    # device's real logical block size. Integer MiB is plenty here.
    printf '%s MiB\n' "$(( sectors / 2048 ))"
}

disk_model() {
    local name="$1"
    cat "/sys/block/${name}/device/model" 2>/dev/null || printf 'unknown'
}

cmd_list() {
    local name live
    live="$(live_device)"
    msg "Candidate target disks"
    for name in $(list_disks); do
        case "$live" in
            "/dev/${name}"*) info "/dev/${name}  $(disk_size_human "$name")  [live media -- not a candidate]"; continue ;;
        esac
        info "/dev/${name}  $(disk_size_human "$name")  $(disk_model "$name" | tr -d '\n')"
    done
}

# ---------------------------------------------------------------------------
# Partitioning
# ---------------------------------------------------------------------------

# nvme0n1 -> nvme0n1p1, but sda -> sda1. The `p` goes in exactly where
# the base name already ends in a digit.
partition_of() {
    local disk="$1" n="$2"
    case "$disk" in
        *[0-9]) printf '%sp%s\n' "$disk" "$n" ;;
        *)      printf '%s%s\n'  "$disk" "$n" ;;
    esac
}

# What this machine booted with. /sys/firmware/efi exists if and only
# if the kernel was started by UEFI firmware -- it is the kernel's own
# record of how it got here, not a guess from hardware.
#
# Defaulting to it matters: installing the other one produces a disk
# this machine cannot boot, and the person doing the install is
# unlikely to find out until they remove the medium.
detect_firmware() {
    if [ -n "$FIRMWARE" ]; then
        case "$FIRMWARE" in
            uefi|bios) return 0 ;;
            *) die "unknown firmware '$FIRMWARE' (expected: uefi, bios)" ;;
        esac
    fi
    if [ -d /sys/firmware/efi ]; then
        FIRMWARE=uefi
    else
        FIRMWARE=bios
    fi
}

unmount_everything_on() {
    local disk="$1" mp
    # Reverse order so nested mounts (/mnt/x/y before /mnt/x) come off first.
    for mp in $(awk -v d="$disk" 'index($1, d) == 1 { print $2 }' /proc/mounts | tac); do
        warn "unmounting $mp (on $disk)"
        umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
    done
}

wait_for_partition() {
    local part="$1" disk="$2" tries=0
    while [ ! -b "$part" ] && [ "$tries" -lt 10 ]; do
        tries=$(( tries + 1 ))
        sleep 1
        partprobe "$disk" 2>/dev/null || true
        if [ -x /sbin/mdev ]; then
            mdev -s 2>/dev/null || true
        fi
    done
    [ -b "$part" ] || die "partition $part never appeared after partitioning $disk"
}

wipe_disk_ends() {
    local disk="$1" sectors

    # Zero the first 1 MiB: any old partition table, any old bootloader,
    # and the post-MBR gap. Also the last 1 MiB, so a leftover GPT
    # backup header at the end of the disk cannot make the kernel
    # prefer a GPT that no longer exists -- or, when we are the ones
    # writing a GPT, so a stale one cannot be mistaken for ours.
    dd if=/dev/zero of="$disk" bs=1M count=1 conv=notrunc 2>/dev/null ||
        die "cannot write to $disk"
    sectors="$(cat "/sys/block/$(basename "$disk")/size" 2>/dev/null || echo 0)"
    if [ "$sectors" -gt 4096 ]; then
        dd if=/dev/zero of="$disk" bs=512 count=2048 \
           seek=$(( sectors - 2048 )) conv=notrunc 2>/dev/null || true
    fi
    sync
}

# ---------------------------------------------------------------------------
# Partitioning
# ---------------------------------------------------------------------------

partition_uefi() {
    local disk="$1"

    msg "Partitioning $disk (GPT: EFI System + Linux)"
    unmount_everything_on "$disk"
    wipe_disk_ends "$disk"

    command -v novi-gpt >/dev/null 2>&1 ||
        die "novi-gpt not found; cannot write a GPT (BusyBox fdisk cannot)"
    novi-gpt "$disk" --esp-mib "$ESP_MIB" >&2 ||
        die "novi-gpt failed on $disk"

    partprobe "$disk" 2>/dev/null || true
    sync

    ESP_PART="$(partition_of "$disk" 1)"
    ROOT_PART="$(partition_of "$disk" 2)"
    wait_for_partition "$ESP_PART" "$disk"
    wait_for_partition "$ROOT_PART" "$disk"
    info "ESP $ESP_PART, root $ROOT_PART"
}

# The BIOS layout for an encrypted install: two partitions instead of
# one, because GRUB has to read a kernel out of something it can read.
# p1 is a plain ext4 /boot; p2 is the container.
#
# Partition 1 still starts at 2048 for the post-MBR gap, for exactly
# the reason the unencrypted layout does.
partition_bios_encrypted() {
    local disk="$1" boot_end root_start

    msg "Partitioning $disk (MBR: /boot + LUKS root)"
    unmount_everything_on "$disk"
    wipe_disk_ends "$disk"

    # 2048 sectors per MiB at 512 bytes; the last sector of p1 is one
    # short of where p2 begins.
    boot_end=$(( 2048 + BOOT_MIB * 2048 - 1 ))
    root_start=$(( boot_end + 1 ))

    # Same keystroke-driven fdisk as the unencrypted path -- BusyBox
    # fdisk has no script mode -- with a second partition and the boot
    # flag on the one GRUB reads.
    #
    # The FIRST SECTOR OF PARTITION 2 IS GIVEN EXPLICITLY, and that is
    # the whole trick. BusyBox fdisk's default first sector for a new
    # partition is 63 -- the start of the disk -- not the first free
    # sector after the partitions that already exist, which is what
    # util-linux offers and what anyone writing this expects. Taking
    # the default produced a partition 2 running 63..2047: 992 KB,
    # overlapping the post-MBR gap, and cryptsetup refused it with
    # "keyslots area is very small" and "Cannot wipe header", which
    # names neither the size nor the cause. Verified against this
    # repo's own static BusyBox on a 12 GB sparse file before it went
    # anywhere near a disk.
    printf 'o\nn\np\n1\n2048\n%s\nn\np\n2\n%s\n\na\n1\nw\n' \
        "$boot_end" "$root_start" |
        fdisk -u "$disk" >/dev/null 2>&1 || true

    partprobe "$disk" 2>/dev/null || true
    sync

    ESP_PART=""
    BOOT_PART="$(partition_of "$disk" 1)"
    ROOT_PART="$(partition_of "$disk" 2)"
    wait_for_partition "$BOOT_PART" "$disk"
    wait_for_partition "$ROOT_PART" "$disk"
    info "boot $BOOT_PART, encrypted root $ROOT_PART"
}

partition_bios() {
    local disk="$1"

    msg "Partitioning $disk (MBR, one Linux partition)"
    unmount_everything_on "$disk"
    wipe_disk_ends "$disk"

    # First sector 2048 is not cosmetic alignment here: it leaves the
    # ~1 MiB post-MBR gap that core.img is written into further down.
    # A partition starting at the old default of 63 would be overwritten
    # by the bootloader, or vice versa.
    #
    # BusyBox fdisk has no sfdisk-style script mode, so it is driven by
    # the keystrokes a person would type: new DOS label, new primary
    # partition 1 from 2048 to the end of the disk, mark it bootable,
    # write. Verified against this repo's own static BusyBox.
    printf 'o\nn\np\n1\n2048\n\na\n1\nw\n' | fdisk -u "$disk" >/dev/null 2>&1 || true

    # fdisk's own BLKRRPART often fails while anything on the disk is
    # still open; partprobe afterwards is what actually makes the kernel
    # publish the new partition node.
    partprobe "$disk" 2>/dev/null || true
    sync

    ESP_PART=""
    ROOT_PART="$(partition_of "$disk" 1)"
    wait_for_partition "$ROOT_PART" "$disk"
    info "root $ROOT_PART"
}

partition_disk() {
    case "$FIRMWARE" in
        uefi) partition_uefi "$1" ;;
        *)    if [ "$ENCRYPT" -eq 1 ]; then
                  partition_bios_encrypted "$1"
              else
                  partition_bios "$1"
              fi ;;
    esac
}

# ---------------------------------------------------------------------------
# Encryption (RFC 0018)
# ---------------------------------------------------------------------------

# Turn ROOT_PART into a LUKS2 container and open it. After this,
# ROOT_DEV is the mapper device and nothing downstream needs to know
# which kind of install this is.
#
# The passphrase goes to cryptsetup on stdin, never as an argument:
# /proc/<pid>/cmdline is world-readable, and on a live installer the
# person watching the screen is not necessarily the only user. Same
# rule as novi-wifi's --stdin (RFC 0017).
setup_luks() {
    command -v cryptsetup >/dev/null 2>&1 ||
        die "cryptsetup not found -- this medium cannot make an encrypted install"

    LUKS_PART="$ROOT_PART"
    msg "Creating a LUKS2 container on $LUKS_PART"

    # --batch-mode: the "are you sure, type YES" prompt has already
    # been asked once by confirm_destruction, and asking it twice
    # trains people to type YES without reading.
    printf '%s\n' "$LUKS_PASSPHRASE" |
        cryptsetup luksFormat --batch-mode --type luks2 "$LUKS_PART" ||
        die "cryptsetup luksFormat failed on $LUKS_PART"

    printf '%s\n' "$LUKS_PASSPHRASE" |
        cryptsetup open "$LUKS_PART" "$LUKS_NAME" ||
        die "cryptsetup could not open the container it just created"
    LUKS_OPENED=1

    # The header UUID, which is what the boot menu will name. Read back
    # from the header rather than remembered from luksFormat: this is
    # the value the initramfs will look for with blkid, so it should
    # come from the same place blkid reads it.
    LUKS_UUID="$(cryptsetup luksUUID "$LUKS_PART")" ||
        die "could not read the LUKS UUID of $LUKS_PART"
    [ -n "$LUKS_UUID" ] || die "cryptsetup luksUUID returned nothing"

    ROOT_DEV="/dev/mapper/$LUKS_NAME"
    info "container open at $ROOT_DEV (UUID $LUKS_UUID)"
}

# Called after partitioning, before formatting. One line decides.
prepare_root_device() {
    if [ "$ENCRYPT" -eq 1 ]; then
        setup_luks
    else
        ROOT_DEV="$ROOT_PART"
    fi
}

# ---------------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------------

# e2fsprogs' mke2fs, installed as mke2fs.e2fsprogs so it sits beside
# BusyBox's applet rather than on top of it (RFC 0008). BusyBox's makes
# ext2 with no journal, which on real hardware turns an unclean
# shutdown into a full fsck and a risk to data. If it is somehow
# missing, fall back rather than refuse -- an ext2 root is worse than
# ext4 and much better than no install -- but say so.
make_root_fs() {
    local part="$1"
    if command -v mke2fs.e2fsprogs >/dev/null 2>&1; then
        msg "Creating an ext4 filesystem on $part (label $ROOT_LABEL)"
        mke2fs.e2fsprogs -q -t ext4 -L "$ROOT_LABEL" -F "$part" ||
            die "mke2fs failed on $part"
        ROOT_FSTYPE=ext4
    else
        warn "e2fsprogs mke2fs not found -- falling back to BusyBox ext2"
        warn "the root filesystem will have NO JOURNAL"
        mke2fs -F -L "$ROOT_LABEL" "$part" >/dev/null 2>&1 ||
            die "mke2fs failed on $part"
        ROOT_FSTYPE=ext2
    fi
    sync
    info "root filesystem: $ROOT_FSTYPE"
}

make_esp() {
    local part="$1"
    msg "Creating a FAT32 EFI System partition on $part"
    # BusyBox mkfs.vfat always makes FAT32, which is what an ESP must
    # be. Mounting it needs codepage 437 in the kernel -- see
    # kernel/config-x86_64, where that was missing.
    mkfs.vfat -n "$ESP_LABEL" "$part" >/dev/null 2>&1 ||
        die "mkfs.vfat failed on $part"
    sync
    info "ESP created"
}

# The unencrypted /boot of a BIOS encrypted install. ext4 because GRUB
# reads ext, and because it holds a kernel that a future update has to
# be able to replace.
make_boot_fs() {
    local part="$1"
    msg "Creating an ext4 filesystem on $part (label $BOOT_LABEL)"
    if command -v mke2fs.e2fsprogs >/dev/null 2>&1; then
        mke2fs.e2fsprogs -q -t ext4 -L "$BOOT_LABEL" -F "$part" ||
            die "mke2fs failed on $part"
    else
        mke2fs -F -L "$BOOT_LABEL" "$part" >/dev/null 2>&1 ||
            die "mke2fs failed on $part"
    fi
    sync
}

format_partitions() {
    # ROOT_DEV, not ROOT_PART: on an encrypted install the filesystem
    # goes inside the container, and formatting the partition would
    # destroy the header that was just written to it.
    make_root_fs "$ROOT_DEV"
    [ -n "$ESP_PART" ] && make_esp "$ESP_PART"
    [ -n "$BOOT_PART" ] && make_boot_fs "$BOOT_PART"
    return 0
}

# ---------------------------------------------------------------------------
# Copying the system
# ---------------------------------------------------------------------------

copy_system() {
    msg "Copying the running system to $MNT (this takes a while)"

    mkdir -p "$MNT"
    mount "$ROOT_DEV" "$MNT" ||
        die "could not mount the new filesystem at $MNT"
    MOUNTED=1

    # Copy from `/`, not from the squashfs: `/` is the overlay, so
    # whatever the person changed in this live session (a password, a
    # novi-state edit) is part of what gets installed. That is what a
    # live installer is for.
    #
    # The exclusions are the kernel-owned mounts plus /mnt itself --
    # which is where the target filesystem is mounted right now, and
    # copying it into itself would not terminate.
    ( cd / && tar -cf - \
        --exclude=./proc \
        --exclude=./sys \
        --exclude=./dev \
        --exclude=./run \
        --exclude=./tmp \
        --exclude=./mnt \
        --exclude=./lost+found \
        . ) | ( cd "$MNT" && tar -xf - ) || \
        die "copying the system failed"

    # Recreate the mount points the copy deliberately skipped.
    mkdir -p "$MNT/proc" "$MNT/sys" "$MNT/dev" "$MNT/run" "$MNT/mnt" "$MNT/boot"
    mkdir -p "$MNT/tmp" && chmod 1777 "$MNT/tmp"

    # Before the ESP: /boot/efi lives inside /boot, so mounting the ESP
    # first and the boot partition on top of it would bury the ESP
    # mount -- the same shape of bug as /run/live in RFC 0003, where a
    # bind mount was made and then something else was moved on top of
    # it, and nothing noticed for as long as nothing needed it.
    if [ -n "$BOOT_PART" ]; then
        mkdir -p "$MNT/boot"
        mount "$BOOT_PART" "$MNT/boot" ||
            die "could not mount the boot partition at $MNT/boot"
        BOOT_MOUNTED=1
        info "boot partition mounted at /boot"
    fi

    # The ESP is mounted where it will live on the installed machine,
    # so the bootloader step writes to the same path fstab names and
    # nothing has to be moved afterwards.
    if [ -n "$ESP_PART" ]; then
        mkdir -p "$MNT/boot/efi"
        mount -t vfat "$ESP_PART" "$MNT/boot/efi" ||
            die "could not mount the EFI System partition at $MNT/boot/efi"
        ESP_MOUNTED=1
        info "ESP mounted at /boot/efi"
    fi

    sync
    info "system copied"
}

# ---------------------------------------------------------------------------
# Making the copy an installed system rather than a copy of a live one
# ---------------------------------------------------------------------------

write_fstab() {
    msg "Writing /etc/fstab"
    cat > "$MNT/etc/fstab" <<FSTAB
# /etc/fstab — Novi Linux
#
# Filesystems are found by LABEL, not by device node: /dev/sda and
# /dev/vda are the same disk under different controllers, and a label
# survives being moved between them.
LABEL=${ROOT_LABEL}   /       ${ROOT_FSTYPE}    rw,noatime      0 1
FSTAB

    if [ -n "$BOOT_PART" ]; then
        cat >> "$MNT/etc/fstab" <<FSTAB

# An unencrypted /boot. It holds the kernel, the initramfs and the boot
# menu -- everything that has to be readable before the passphrase can
# be asked for (RFC 0018). Nothing secret belongs here.
LABEL=${BOOT_LABEL}   /boot   ext4    rw,noatime,nofail  0 2
FSTAB
    fi

    if [ -n "$ESP_PART" ]; then
        cat >> "$MNT/etc/fstab" <<FSTAB

# The EFI System partition. Nothing at runtime needs it -- the firmware
# reads it before Linux exists -- but a kernel update has to write
# there, so it is mounted rather than left for someone to find.
# nofail, so a machine whose ESP has been removed or corrupted still
# boots to a prompt where that can be fixed.
LABEL=${ESP_LABEL}    /boot/efi vfat  rw,noatime,nofail  0 2
FSTAB
    fi

    cat >> "$MNT/etc/fstab" <<'FSTAB'

# The kernel-owned filesystems are mounted by s6-linux-init's stage 1,
# not from here. They are listed for the benefit of anything that reads
# fstab to find out what the system looks like.
proc                  /proc   proc    defaults        0 0
sysfs                 /sys    sysfs   defaults        0 0
devtmpfs              /dev    devtmpfs defaults       0 0
tmpfs                 /tmp    tmpfs   mode=1777       0 0
FSTAB
}

set_hostname() {
    [ -n "$NEW_HOSTNAME" ] || return 0
    msg "Setting hostname to '$NEW_HOSTNAME'"

    # Through novi-state, not sed: /etc/novi/system.conf is the declared
    # truth (RFC 0002), and `set` is the one edit that preserves the
    # file's comments and ordering. NOVI_STATE_FILE points it at the
    # target's copy instead of the live system's.
    if [ -x /usr/bin/novi-state ] && [ -f "$MNT/etc/novi/system.conf" ]; then
        NOVI_STATE_FILE="$MNT/etc/novi/system.conf" \
            /usr/bin/novi-state set hostname "$NEW_HOSTNAME" >/dev/null 2>&1 || \
            warn "could not update the declared hostname"
    fi

    # Also write /etc/hostname directly, so the first boot comes up with
    # the right name before boot convergence has run at all.
    printf '%s\n' "$NEW_HOSTNAME" > "$MNT/etc/hostname"
}

# Where GRUB will look for the kernel, as a path inside $MNT, and the
# path GRUB itself must use to name it.
#
# Three cases, and they differ only because of what GRUB can read:
#
#   plain              $MNT/boot        GRUB reads the root filesystem
#   encrypted, UEFI    $MNT/boot/efi    GRUB reads the ESP
#   encrypted, BIOS    $MNT/boot        which IS partition 1 here
#
# The third looks the same as the first and is not: /boot is a separate
# unencrypted filesystem, so the path GRUB uses is /vmlinuz, not
# /boot/vmlinuz. That is the whole reason mkiso.sh generates a second
# core.img with a different prefix.
kernel_dest_dir() {
    if [ "$ENCRYPT" -eq 1 ] && [ "$FIRMWARE" = "uefi" ]; then
        printf '%s' "$MNT/boot/efi"
    else
        printf '%s' "$MNT/boot"
    fi
}

# The same location as GRUB names it: relative to whatever partition
# GRUB will have set as its root.
kernel_grub_prefix() {
    if [ "$ENCRYPT" -eq 1 ]; then
        printf ''          # the kernel is at the root of the ESP or of /boot
    else
        printf '/boot'
    fi
}

install_kernel() {
    local dest
    dest="$(kernel_dest_dir)"
    msg "Installing kernel and initramfs into $dest"

    mkdir -p "$dest"

    # The ISO carries the exact kernel/initramfs pair that just booted
    # this session, under stable names. Prefer them; fall back to
    # whatever versioned vmlinuz the rootfs itself shipped.
    local kernel=""
    if [ -f "$LIVE_DIR/boot/vmlinuz" ]; then
        kernel="$LIVE_DIR/boot/vmlinuz"
    else
        # Fall back to the versioned image the rootfs itself shipped
        # (/boot/vmlinuz-6.10.3, copied in with the rest of the
        # system). The running system's own copy is checked too: on an
        # encrypted BIOS install $MNT/boot is a freshly formatted
        # partition mounted over the one the copy just wrote, so the
        # target's copy is there but hidden.
        local candidate
        for candidate in "$MNT"/boot/vmlinuz-* /boot/vmlinuz-*; do
            [ -f "$candidate" ] || continue
            kernel="$candidate"
            break
        done
    fi
    [ -n "$kernel" ] || \
        die "no kernel image found to install (looked in $LIVE_DIR/boot and $MNT/boot)"
    cp "$kernel" "$dest/vmlinuz.new" && mv "$dest/vmlinuz.new" "$dest/vmlinuz"

    if [ -f "$LIVE_DIR/boot/initramfs.cpio.gz" ]; then
        cp "$LIVE_DIR/boot/initramfs.cpio.gz" "$dest/initramfs.cpio.gz"
    else
        die "no initramfs found at $LIVE_DIR/boot/initramfs.cpio.gz"
    fi

    info "kernel and initramfs installed"
}

# ---------------------------------------------------------------------------
# Bootloader
# ---------------------------------------------------------------------------

# The boot menu, written once and used by both firmware paths. Only
# where it lands differs: /boot/grub/grub.cfg for BIOS (core.img's
# baked-in prefix) or /boot/efi/EFI/BOOT/grub.cfg for UEFI (bootx64.efi's).
write_grub_cfg() {
    local dest="$1" search_line="$2"
    local kroot rootspec cryptline=""

    # Where the kernel is, from GRUB's point of view, and what to tell
    # the kernel its root is. On an encrypted install the root is the
    # mapper device the initramfs is about to create, and novi.luks=
    # is what tells it to (RFC 0018).
    kroot="$(kernel_grub_prefix)"
    if [ "$ENCRYPT" -eq 1 ]; then
        rootspec="/dev/mapper/${LUKS_NAME}"
        cryptline="novi.luks=UUID=${LUKS_UUID}"
    else
        rootspec="LABEL=${ROOT_LABEL}"
    fi

    mkdir -p "$(dirname "$dest")"
    cat > "$dest" <<GRUBCFG
# Novi Linux — installed system boot menu
# Written by novi-install.

set default=0
set timeout=3
set timeout_style=menu

insmod part_gpt
insmod part_msdos
insmod fat
insmod ext2
insmod all_video
insmod gzio

# Serial as well as VGA, so a headless machine still shows the menu.
insmod serial
serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial

${search_line}

menuentry "Novi Linux" --class linux {
    linux  ${kroot}/vmlinuz root=${rootspec} ${cryptline} rw \\
           quiet loglevel=3 \\
           console=tty0 console=ttyS0,115200n8 \\
           vt.global_cursor_default=0
    initrd ${kroot}/initramfs.cpio.gz
}

menuentry "Novi Linux (verbose)" --class linux {
    linux  ${kroot}/vmlinuz root=${rootspec} ${cryptline} rw \\
           loglevel=7 \\
           console=tty0 console=ttyS0,115200n8
    initrd ${kroot}/initramfs.cpio.gz
}

# If a declared state ever locks you out -- every getty turned off, say
# -- this entry boots without converging to it. See RFC 0002.
menuentry "Novi Linux (skip declared-state convergence)" --class linux {
    linux  ${kroot}/vmlinuz root=${rootspec} ${cryptline} rw \\
           novi.state=off loglevel=7 \\
           console=tty0 console=ttyS0,115200n8
    initrd ${kroot}/initramfs.cpio.gz
}
GRUBCFG
}

install_bootloader_uefi() {
    local src="$LIVE_DIR/novi-boot"

    msg "Installing the UEFI bootloader"

    [ "$ESP_MOUNTED" -eq 1 ] || die "the ESP is not mounted"
    [ -f "$src/bootx64.efi" ] || {
        warn "no $src/bootx64.efi on this medium"
        warn "the system is installed but NOT bootable on its own."
        return 0
    }

    # /EFI/BOOT/BOOTX64.EFI is the removable-media path every UEFI
    # implementation looks for without being told. Using it rather than
    # a vendor directory plus an NVRAM boot entry means the install
    # needs no efibootmgr, no writable EFI variables, and works on
    # firmware that has forgotten its boot order -- which is most
    # firmware, eventually.
    mkdir -p "$MNT/boot/efi/EFI/BOOT"
    cp "$src/bootx64.efi" "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" ||
        die "could not copy bootx64.efi to the ESP"

    # bootx64.efi's prefix is /EFI/BOOT, so grub.cfg goes beside it on
    # the ESP either way. What differs is where the kernel is, and
    # therefore what `search` has to find:
    #
    #   plain      the kernel is on the root filesystem, so search for
    #              the root label
    #   encrypted  GRUB cannot read the root filesystem at all, so the
    #              kernel is on the ESP and search finds the ESP
    if [ "$ENCRYPT" -eq 1 ]; then
        write_grub_cfg "$MNT/boot/efi/EFI/BOOT/grub.cfg" \
            "search --no-floppy --label ${ESP_LABEL} --set=root"
    else
        write_grub_cfg "$MNT/boot/efi/EFI/BOOT/grub.cfg" \
            "search --no-floppy --label ${ROOT_LABEL} --set=root"
    fi

    sync
    info "bootx64.efi and grub.cfg installed on the ESP"
}

install_bootloader_bios() {
    local disk="$1" src="$LIVE_DIR/novi-boot" core_sectors
    local core="core.img" grubdir="$MNT/boot/grub"

    msg "Installing the BIOS bootloader on $disk"

    # Which core.img, and therefore which prefix. mkiso.sh generates
    # both because the prefix is baked in at grub-mkimage time and
    # cannot be changed here (RFC 0003, RFC 0018):
    #
    #   core.img       (hd0,msdos1)/boot/grub   partition 1 IS the root
    #   core-boot.img  (hd0,msdos1)/grub        partition 1 IS /boot
    #
    # $MNT/boot is the boot partition's mountpoint in the encrypted
    # case, so $MNT/boot/grub is (hd0,msdos1)/grub. The two lines below
    # look identical and mean different things.
    if [ "$ENCRYPT" -eq 1 ]; then
        core="core-boot.img"
    fi

    # No search either way: the kernel is on the same partition
    # core.img's prefix already points at.
    write_grub_cfg "$grubdir/grub.cfg" ""

    if [ ! -d "$src" ]; then
        warn "no staged GRUB artifacts at $src"
        warn "the system is installed but NOT bootable on its own --"
        warn "boot the ISO and pass root=LABEL=${ROOT_LABEL} by hand."
        return 0
    fi

    [ -f "$src/boot.img" ] || die "$src/boot.img missing"
    [ -f "$src/$core" ] || die "$src/$core missing"

    # GRUB's modules must be readable from the installed filesystem:
    # core.img loads the rest of GRUB from its prefix at boot.
    mkdir -p "$grubdir/i386-pc"
    cp "$src"/i386-pc/* "$grubdir/i386-pc/" 2>/dev/null ||
        warn "no GRUB modules staged -- boot may fail"
    sync

    # Stage 1: the first 446 bytes of the MBR. Exactly 446, never 512 --
    # bytes 446..509 are the partition table that was just written, and
    # a 512-byte dd would erase it.
    dd if="$src/boot.img" of="$disk" bs=446 count=1 conv=notrunc 2>/dev/null ||
        die "could not write boot.img to the MBR of $disk"

    # Stage 1.5: core.img into the post-MBR gap, sector 1 onwards. The
    # partition starts at sector 2048, so there is room for 2047
    # sectors; refuse rather than write into the filesystem.
    core_sectors="$(( ( $(wc -c < "$src/$core") + 511 ) / 512 ))"
    [ "$core_sectors" -lt 2047 ] ||
        die "$core is ${core_sectors} sectors -- too big for the 2047-sector gap"
    dd if="$src/$core" of="$disk" bs=512 seek=1 conv=notrunc 2>/dev/null ||
        die "could not write $core to the post-MBR gap of $disk"

    sync
    info "bootloader installed (${core_sectors} sectors of $core in the gap)"
}

install_bootloader() {
    case "$FIRMWARE" in
        uefi) install_bootloader_uefi ;;
        *)    install_bootloader_bios "$1" ;;
    esac
}

# ---------------------------------------------------------------------------
# Profile: what software the installed machine gets
# ---------------------------------------------------------------------------

# The desktop is not in the base image (RFC 0007) -- it is packages, and
# this medium carries the whole signed repository. So installing a
# desktop is a package install, run inside the target, against a mirror
# that is a directory on the ISO. No network, and the same signature and
# hash verification a network install would get.
#
# Done in a chroot rather than with pkg's PKG_ROOT: PKG_ROOT relocates
# where FILES land but not the install database, so a PKG_ROOT install
# would put the desktop on the target and record it in the live system's
# database -- an installed machine that does not know what it has.
install_profile() {
    local repo="$LIVE_DIR/novi-repo"
    local bind="$MNT/mnt/novi-repo"

    case "$PROFILE" in
        console)
            msg "Console profile -- no desktop packages"
            return 0 ;;
        desktop) : ;;
        *) die "unknown profile '$PROFILE' (expected: desktop, console)" ;;
    esac

    if [ ! -f "$repo/index" ]; then
        warn "no package repository at $repo"
        warn "installing a console system instead; add a mirror and run"
        warn "'pkg install novi-desktop' on the installed machine."
        PROFILE=console
        return 0
    fi

    msg "Installing the desktop from the repository on this medium"

    mkdir -p "$bind"
    mount --bind "$repo" "$bind" ||
        die "could not make the repository visible inside the target"

    # Point the target's pkg at the bind mount for the duration. The
    # real mirror is written once, at the end, by finalize_pkg_conf().
    sed -i 's|^mirror = .*|mirror = /mnt/novi-repo|' "$MNT/etc/novi/pkg.conf"

    if chroot "$MNT" /usr/bin/pkg sync &&
       chroot "$MNT" /usr/bin/pkg install novi-desktop; then
        info "desktop installed"
    else
        umount "$bind" 2>/dev/null || true
        rmdir "$bind" 2>/dev/null || true
        die "installing the desktop failed"
    fi

    umount "$bind" 2>/dev/null || warn "could not unmount $bind"
    rmdir "$bind" 2>/dev/null || true

    # Declare what was installed, and turn the session on. Without this
    # the machine would have a desktop it never starts, and
    # `novi-state diff` would report drift on a fresh install.
    target_state_set packages.novi-desktop present
    target_state_set services.seatd on
    target_state_set services.novi-shell on
}

# `novi-state set` against the TARGET's document. Used for everything
# the installer declares -- it is the one edit that preserves the
# file's comments and ordering (RFC 0002), which matters most in the
# document a person meets first.
target_state_set() {
    [ -x /usr/bin/novi-state ] || return 0
    [ -f "$MNT/etc/novi/system.conf" ] || return 0
    NOVI_STATE_FILE="$MNT/etc/novi/system.conf" \
        /usr/bin/novi-state set "$1" "$2" >/dev/null 2>&1 ||
        warn "could not declare $1 = $2"
}

# The shipped pkg.conf points at /run/live/novi-repo, which is this
# medium. That path does not exist once the medium is removed, so
# leaving it would give every installed machine a `pkg sync` that fails
# with a confusing error about a directory nobody chose.
finalize_pkg_conf() {
    local conf="$MNT/etc/novi/pkg.conf"
    [ -f "$conf" ] || return 0

    if [ -n "$TARGET_MIRROR" ]; then
        sed -i "s|^mirror = .*|mirror = ${TARGET_MIRROR}|" "$conf"
        info "package mirror: $TARGET_MIRROR"
    else
        sed -i 's|^mirror = .*|# mirror =   (none configured -- see below)|' "$conf"
        info "no package mirror configured (pass --mirror next time)"
    fi
}

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------

# Read a password twice without echoing it. `stty -echo` rather than
# `read -s`: both work under BusyBox ash, but the trap makes the
# terminal recoverable if this is interrupted, which `read -s` alone
# would not be -- a Ctrl-C mid-prompt otherwise leaves the console with
# echo permanently off and no obvious way back.
prompt_password() {
    local label="$1" first="" second=""
    PASSWORD=""
    while : ; do
        printf '  %s password: ' "$label" >&2
        stty -echo 2>/dev/null || true
        # shellcheck disable=SC2162
        read first
        stty echo 2>/dev/null || true
        printf '\n' >&2

        printf '  %s password (again): ' "$label" >&2
        stty -echo 2>/dev/null || true
        # shellcheck disable=SC2162
        read second
        stty echo 2>/dev/null || true
        printf '\n' >&2

        if [ -z "$first" ]; then
            warn "empty password -- try again, or Ctrl-C to abort"
            continue
        fi
        if [ "$first" != "$second" ]; then
            warn "passwords did not match -- try again"
            continue
        fi
        PASSWORD="$first"
        return 0
    done
}

set_target_password() {
    local who="$1" pw="$2"
    # chpasswd's own -R chroots for us, so this needs no working
    # /proc or /dev inside the target -- and hashes with sha512
    # rather than BusyBox's DES default, which truncates at 8
    # characters and would silently make a long password weak.
    printf '%s:%s\n' "$who" "$pw" | chpasswd -c sha512 -R "$MNT" ||
        die "failed to set the password for '$who'"
}

create_user() {
    [ -n "$NEW_USER" ] || return 0
    local g

    msg "Creating user '$NEW_USER' on the installed system"

    # Created inside the target, not declared and left for first boot,
    # so the machine is usable the moment it boots rather than after
    # someone logs in as root to finish the job. The declaration below
    # then matches what is already there, and `novi-state diff` on the
    # installed system is clean rather than showing a user it is about
    # to create.
    chroot "$MNT" /bin/busybox adduser -D -s "$NEW_USER_SHELL" "$NEW_USER" ||
        die "could not create user '$NEW_USER'"

    for g in $(printf '%s' "$NEW_USER_GROUPS" | tr ',' ' '); do
        if grep -q "^${g}:" "$MNT/etc/group"; then
            chroot "$MNT" /bin/busybox addgroup "$NEW_USER" "$g" ||
                warn "could not add '$NEW_USER' to group '$g'"
        else
            warn "group '$g' does not exist on the target -- skipped"
        fi
    done

    if [ "$NO_PASSWORD" -eq 1 ]; then
        warn "'$NEW_USER' has no password and cannot log in until one is set"
    else
        prompt_password "$NEW_USER"
        set_target_password "$NEW_USER" "$PASSWORD"
        PASSWORD=""
    fi

    # And declare it, so the account is part of the document that
    # governs this machine rather than a fact about it nobody wrote
    # down. The password is deliberately NOT declared -- system.conf is
    # world-readable and meant to be committed to git.
    if [ -x /usr/bin/novi-state ] && [ -f "$MNT/etc/novi/system.conf" ]; then
        NOVI_STATE_FILE="$MNT/etc/novi/system.conf" \
            /usr/bin/novi-state set "users.${NEW_USER}.shell" "$NEW_USER_SHELL" \
            >/dev/null 2>&1 || warn "could not declare users.${NEW_USER}.shell"
        NOVI_STATE_FILE="$MNT/etc/novi/system.conf" \
            /usr/bin/novi-state set "users.${NEW_USER}.groups" \
            "$(printf '%s' "$NEW_USER_GROUPS" | tr ',' '\n' | sort | tr '\n' ',' | sed 's/,$//')" \
            >/dev/null 2>&1 || warn "could not declare users.${NEW_USER}.groups"
    fi

    info "user '$NEW_USER' created and declared"
}

set_root_password() {
    [ "$SET_ROOT_PASSWORD" -eq 1 ] || return 0
    msg "Setting the root password on the installed system"
    prompt_password "root"
    set_target_password root "$PASSWORD"
    PASSWORD=""
}

# The shipped image has an empty root password on purpose -- an
# installable live image nobody can log into is useless. An installed
# machine is a different thing, and shipping one that way silently
# would be indefensible.
warn_if_root_passwordless() {
    local field
    field="$(awk -F: '$1 == "root" { print $2 }' "$MNT/etc/shadow" 2>/dev/null)"
    [ -z "$field" ] || return 0
    printf '\n' >&2
    warn "root on the installed system has NO PASSWORD."
    warn "Anyone at the console can log in as root. Fix it on first boot:"
    warn "    passwd"
    warn "or re-run this installer with --set-root-password."
}

# ---------------------------------------------------------------------------
# Confirmation
# ---------------------------------------------------------------------------

confirm_destruction() {
    local disk="$1" name
    name="$(basename "$disk")"

    printf '\n' >&2
    printf '  ABOUT TO ERASE %s (%s, %s)\n' \
        "$disk" "$(disk_size_human "$name")" "$(disk_model "$name" | tr -d '\n')" >&2
    printf '  Everything on that disk will be destroyed. There is no undo.\n\n' >&2

    if [ "$ASSUME_YES" -eq 1 ]; then
        info "--yes given, proceeding"
        return 0
    fi

    printf "  Type 'yes' to continue: " >&2
    local answer=""
    read -r answer || answer=""
    [ "$answer" = "yes" ] || die "aborted -- nothing was written"
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

cmd_install() {
    need_root

    [ -n "$TARGET_DISK" ] || die "no target disk given (try: novi-install list)"
    [ -b "$TARGET_DISK" ] || die "$TARGET_DISK is not a block device"

    local live
    live="$(live_device)"
    case "$live" in
        "") : ;;
        "${TARGET_DISK}"*)
            die "$TARGET_DISK holds the live media this system is running from" ;;
    esac

    detect_firmware

    for tool in partprobe tar dd mount umount sync chroot chpasswd sed; do
        command -v "$tool" >/dev/null 2>&1 || die "missing required tool: $tool"
    done
    case "$FIRMWARE" in
        uefi) for tool in novi-gpt mkfs.vfat; do
                  command -v "$tool" >/dev/null 2>&1 ||
                      die "missing required tool for a UEFI install: $tool"
              done ;;
        *)    command -v fdisk >/dev/null 2>&1 ||
                  die "missing required tool for a BIOS install: fdisk" ;;
    esac

    if [ "$ENCRYPT" -eq 1 ]; then
        command -v cryptsetup >/dev/null 2>&1 ||
            die "missing required tool for --encrypt: cryptsetup"
    fi

    msg "Firmware: ${FIRMWARE}"

    confirm_destruction "$TARGET_DISK"

    # Asked AFTER the confirmation and BEFORE anything is written: the
    # one thing worse than being asked for a passphrase is being asked
    # for it halfway through a partition table.
    if [ "$ENCRYPT" -eq 1 ]; then
        msg "Disk encryption passphrase"
        info "this unlocks the disk at every boot; there is no way to recover it"
        prompt_password "disk encryption"
        LUKS_PASSPHRASE="$PASSWORD"
        PASSWORD=""
    fi

    partition_disk "$TARGET_DISK"
    prepare_root_device
    format_partitions
    copy_system
    write_fstab
    set_hostname
    create_user
    set_root_password
    install_profile
    finalize_pkg_conf
    install_kernel
    if [ "$WITH_BOOTLOADER" -eq 1 ]; then
        install_bootloader "$TARGET_DISK"
    else
        info "--no-bootloader given, skipping the MBR"
    fi

    warn_if_root_passwordless

    sync
    if [ "$ESP_MOUNTED" -eq 1 ]; then
        umount "$MNT/boot/efi" || warn "could not unmount the ESP cleanly"
        ESP_MOUNTED=0
    fi
    if [ "$BOOT_MOUNTED" -eq 1 ]; then
        umount "$MNT/boot" || warn "could not unmount /boot cleanly"
        BOOT_MOUNTED=0
    fi
    umount "$MNT" || warn "could not unmount $MNT cleanly"
    MOUNTED=0
    # Closing the container is what flushes dm-crypt's own state. An
    # install that ends with it still open looks finished and can still
    # be losing writes.
    if [ "$LUKS_OPENED" -eq 1 ]; then
        cryptsetup close "$LUKS_NAME" || warn "could not close $LUKS_NAME"
        LUKS_OPENED=0
    fi
    sync

    if [ "$ENCRYPT" -eq 1 ]; then
        msg "Novi is installed on $TARGET_DISK (${FIRMWARE}, encrypted ${ROOT_FSTYPE}, ${PROFILE} profile)"
        info "the passphrase is asked for at every boot, by the initramfs"
        info "there is no recovery key -- 'cryptsetup luksAddKey ${LUKS_PART}' adds one"
    else
        msg "Novi is installed on $TARGET_DISK (${FIRMWARE}, ${ROOT_FSTYPE}, ${PROFILE} profile)"
    fi
    info "remove the installation media and reboot"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

[ $# -gt 0 ] || { usage; exit 1; }

ACTION="$1"; shift
case "$ACTION" in
    list|-h|--help|help) : ;;
    install) : ;;
    *) die "unknown command '$ACTION' (try: novi-install --help)" ;;
esac

while [ $# -gt 0 ]; do
    case "$1" in
        --disk)      TARGET_DISK="${2:-}"; shift 2 ;;
        --hostname)  NEW_HOSTNAME="${2:-}"; shift 2 ;;
        --firmware)  FIRMWARE="${2:-}"; shift 2 ;;
        --esp-mib)   ESP_MIB="${2:-}"; shift 2 ;;
        --encrypt)   ENCRYPT=1; shift ;;
        --profile)   PROFILE="${2:-}"; shift 2 ;;
        --mirror)    TARGET_MIRROR="${2:-}"; shift 2 ;;
        --user)          NEW_USER="${2:-}"; shift 2 ;;
        --user-groups)   NEW_USER_GROUPS="${2:-}"; shift 2 ;;
        --user-shell)    NEW_USER_SHELL="${2:-}"; shift 2 ;;
        --no-password)   NO_PASSWORD=1; shift ;;
        --set-root-password) SET_ROOT_PASSWORD=1; shift ;;
        --no-bootloader) WITH_BOOTLOADER=0; shift ;;
        -y|--yes)    ASSUME_YES=1; shift ;;
        -h|--help)   usage; exit 0 ;;
        *) die "unknown option '$1'" ;;
    esac
done

case "$ACTION" in
    list)              cmd_list ;;
    -h|--help|help)    usage ;;
    install)           cmd_install ;;
esac
