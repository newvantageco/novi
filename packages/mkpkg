#!/bin/sh
# ============================================================
# mkpkg — Build a .pkg.tar.gz package from a staging directory
#
# Usage: mkpkg <staging-dir> <output-dir>
#
# The staging-dir must contain:
#   MANIFEST     — package metadata (key=value)
#   files/       — package contents (installed relative to /)
#   scripts/     — optional: pre-install, post-install, pre-remove, post-remove
#
# Example MANIFEST:
#   name=curl
#   version=8.9.1
#   arch=x86_64
#   depends=musl zlib openssl
#   description=Command-line HTTP client
#
# Unlike packages/pkg (the installer, which must run on-target under
# BusyBox ash -- see its own header comment), this is a build-host
# tool: it packages the output of this repo's own build/*.sh stages,
# which already require a GNU/Linux host toolchain (see the main
# CLAUDE.md's build instructions). It deliberately uses GNU tar's
# --owner=/--group= long options, which BusyBox's tar applet doesn't
# implement -- not an oversight, just not this script's target runtime.
# ============================================================
#
# shellcheck disable=SC3040
# `set -o pipefail` is outside strict POSIX sh (shellcheck's default
# dialect for a `#!/bin/sh` shebang), but this repo's build host is a
# regular GNU/Linux machine with bash or dash providing /bin/sh, both
# of which support it.
set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

[ $# -lt 2 ] && die "Usage: mkpkg <staging-dir> <output-dir>"

STAGING="$(realpath "$1")"
OUTDIR="$(realpath "$2")"

[ -d "${STAGING}" ]         || die "Staging directory not found: ${STAGING}"
[ -f "${STAGING}/MANIFEST" ] || die "MANIFEST not found in ${STAGING}"

# ── Parse MANIFEST ────────────────────────────────────────
get_field() { grep "^${1}=" "${STAGING}/MANIFEST" | cut -d= -f2-; }

PKG_NAME="$(get_field name)"
PKG_VERSION="$(get_field version)"
PKG_ARCH="$(get_field arch)"

[ -n "${PKG_NAME}" ]    || die "MANIFEST missing: name"
[ -n "${PKG_VERSION}" ] || die "MANIFEST missing: version"
[ -n "${PKG_ARCH}" ]    || die "MANIFEST missing: arch"

OUTPUT="${OUTDIR}/${PKG_NAME}-${PKG_VERSION}-${PKG_ARCH}.pkg.tar.gz"
mkdir -p "${OUTDIR}"

echo "[mkpkg] Building ${PKG_NAME}-${PKG_VERSION} (${PKG_ARCH})"

# ── Validate files directory ──────────────────────────────
[ -d "${STAGING}/files" ] || die "files/ directory not found in ${STAGING}"

# ── Compute installed size ────────────────────────────────
INSTALLED_SIZE="$(du -sk "${STAGING}/files" | cut -f1)"

# ── Build the size-injected MANIFEST in a scratch dir, never
#    the staging tree itself ──────────────────────────────
# The staging directory is the caller's source tree, not this
# script's scratch space -- writing the computed MANIFEST back into
# it (an earlier version of this script did, via `cp ... "${STAGING}/
# MANIFEST"`) made a second mkpkg run on the same staging dir corrupt
# it: `grep -v "^size="` strips a stale size= line, but the first
# run's un-prefixed content (previously, an embedded file list; now,
# nothing extra) had no such filter and would just keep accumulating.
# Packing MANIFEST from its own directory via a second `tar -C`
# argument keeps the staging tree untouched and every run idempotent.
PACKDIR="$(mktemp -d)"
trap 'rm -rf "${PACKDIR}"' EXIT
grep -v "^size=" "${STAGING}/MANIFEST" > "${PACKDIR}/MANIFEST"
echo "size=${INSTALLED_SIZE}" >> "${PACKDIR}/MANIFEST"

# ── Validate optional scripts ─────────────────────────────
for script in pre-install post-install pre-remove post-remove; do
    if [ -f "${STAGING}/scripts/${script}" ]; then
        chmod 755 "${STAGING}/scripts/${script}"
        echo "[mkpkg] Found script: ${script}"
    fi
done

# ── Build the package tarball ─────────────────────────────
echo "[mkpkg] Packing → ${OUTPUT}"
if [ -d "${STAGING}/scripts" ]; then
    tar -czf "${OUTPUT}" \
        --numeric-owner \
        --owner=0 --group=0 \
        -C "${PACKDIR}" MANIFEST \
        -C "${STAGING}" files scripts
else
    tar -czf "${OUTPUT}" \
        --numeric-owner \
        --owner=0 --group=0 \
        -C "${PACKDIR}" MANIFEST \
        -C "${STAGING}" files
fi

# ── Verify ────────────────────────────────────────────────
SIZE="$(du -sh "${OUTPUT}" | cut -f1)"
echo "[mkpkg] Done: ${OUTPUT} (${SIZE})"
tar -tzf "${OUTPUT}" | head -5
echo "..."
