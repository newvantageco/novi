# libnsfb: speak xdg-shell instead of wl_shell
#
# RFC 0032. libnsfb's Wayland surface (src/surface/wld.c) binds
# `wl_shell`, which was deprecated in 2016 and which wlroots -- and so
# novi-shell -- has never implemented. The global is simply not there,
# so upstream's code cannot open a window on this desktop at all.
#
# This ports the ~60 lines that touch the shell to xdg-shell:
#
#   * bind xdg_wm_base and answer its ping (the ping moved from the
#     surface to the shell object between the two protocols);
#   * xdg_surface + xdg_toplevel instead of wl_shell_surface, with the
#     configure ACKED -- until a configure is acked the surface has no
#     committed role and the compositor discards any buffer attached
#     to it, so the window silently never appears;
#   * commit with NO buffer and round-trip before drawing, which is
#     what asks for that first configure;
#   * xdg_toplevel.close queued as NSFB_CONTROL_QUIT, which is exactly
#     what NetSurf's framebuffer frontend already checks for. Without
#     it the title bar's close button does nothing.
#
# The generated xdg-shell-protocol.c/.h are produced by
# wayland-scanner in build/35-devtools.sh and added to
# src/surface/Makefile there; they are not part of this patch because
# they are generated, not written.
#
# If this stops applying, the build FAILS rather than silently
# producing a browser that cannot open a window -- the same rule
# 23-e2fsprogs.sh applies to its musl patch.
--- a/libnsfb/src/surface/wld.c
+++ b/libnsfb/src/surface/wld.c
@@ -39,6 +39,11 @@
 #include "plot.h"
 #include "cursor.h"
 
+/* xdg-shell, generated by wayland-scanner into this directory by
+ * build/44-netsurf.sh. See the patch header in that stage for why
+ * this file no longer speaks wl_shell. */
+#include "xdg-shell-protocol.h"
+
 #define UNUSED(x) ((x) = (x))
 
 struct wld_event {
@@ -60,9 +65,12 @@
     struct wl_compositor *compositor;
 
     /** shell object, available once the registry messages have been
-     * processed
+     * processed. xdg_wm_base, not wl_shell: wl_shell was deprecated in
+     * 2016 and wlroots -- and therefore novi-shell -- never
+     * implemented it, so the original code found no global here and
+     * could not open a window at all.
      */
-    struct wl_shell *shell;
+    struct xdg_wm_base *wm_base;
 
     /** shared memory object, available once the registry messages
      * have been processed
@@ -99,7 +107,13 @@
     struct wld_connection* connection; /**< connection to wayland server */
 
     struct wl_surface *surface; /**< drawing surface object */
-    struct wl_shell_surface *shell_surface; /**< shell surface object */
+    struct xdg_surface *xdg_surface; /**< xdg window role */
+    struct xdg_toplevel *xdg_toplevel; /**< toplevel window */
+
+    /** Set once the compositor has sent its first configure and we
+     * have acked it. Attaching a buffer before that is a protocol
+     * error in xdg-shell, and the compositor drops the surface. */
+    bool configured;
 
     int width, height;
 };
@@ -1163,6 +1177,23 @@
     return input;
 }
 
+/* xdg_wm_base pings a client that has been quiet, and a client that
+ * does not pong is one the compositor may report as not responding.
+ * wl_shell had the same ping on the SURFACE; xdg-shell moved it to the
+ * shell object, which is why this handler is up here rather than beside
+ * the toplevel's. */
+static void
+handle_wm_base_ping(void *data, struct xdg_wm_base *wm_base, uint32_t serial)
+{
+    UNUSED(data);
+    xdg_wm_base_pong(wm_base, serial);
+}
+
+static const struct xdg_wm_base_listener wm_base_listener = {
+	handle_wm_base_ping
+};
+
+
 /** registry global addition callback
  *
  * @param ctx context from when listener was added
@@ -1187,12 +1218,19 @@
 						  &wl_compositor_interface,
 						  1);
 
-    } else if (strcmp(interface, "wl_shell") == 0) {
-	/* shell interface is available. Bind the interface */
-	connection->shell = wl_registry_bind(registry,
-					     id,
-					     &wl_shell_interface,
-					     1);
+    } else if (strcmp(interface, "xdg_wm_base") == 0) {
+	/* shell interface is available. Bind the interface and answer
+	 * its ping, or the compositor is entitled to conclude this
+	 * client has hung and say so to the user.
+	 */
+	connection->wm_base = wl_registry_bind(registry,
+					       id,
+					       &xdg_wm_base_interface,
+					       1);
+	if (connection->wm_base != NULL) {
+	    xdg_wm_base_add_listener(connection->wm_base,
+				     &wm_base_listener, connection);
+	}
 
     } else if (strcmp(interface, "wl_shm") == 0) {
 	/* shared memory interface is available. Bind the interface
@@ -1242,8 +1280,8 @@
 	wl_compositor_destroy(connection->compositor);
     }
 
-    if (connection->shell != NULL) {
-	wl_shell_destroy(connection->shell);
+    if (connection->wm_base != NULL) {
+	xdg_wm_base_destroy(connection->wm_base);
     }
 
     if (connection->shm != NULL) {
@@ -1351,35 +1389,64 @@
 }
 
 static void
-handle_ping(void *data, struct wl_shell_surface *shell_surface,
-							uint32_t serial)
+handle_xdg_surface_configure(void *data, struct xdg_surface *xdg_surface,
+			     uint32_t serial)
 {
-    UNUSED(data);
-    wl_shell_surface_pong(shell_surface, serial);
+    struct wld_window *window = data;
+
+    /* ACKNOWLEDGING IS NOT OPTIONAL. Until a configure has been acked
+     * the surface has no committed role and the compositor discards
+     * any buffer attached to it -- the window simply never appears,
+     * with nothing logged on either side. */
+    xdg_surface_ack_configure(xdg_surface, serial);
+    window->configured = true;
 }
 
+static const struct xdg_surface_listener xdg_surface_listener = {
+	handle_xdg_surface_configure
+};
+
 static void
-handle_configure(void *data, struct wl_shell_surface *shell_surface,
-		 uint32_t edges, int32_t width, int32_t height)
+handle_toplevel_configure(void *data, struct xdg_toplevel *xdg_toplevel,
+			  int32_t width, int32_t height, struct wl_array *states)
 {
     UNUSED(data);
-    UNUSED(shell_surface);
-    UNUSED(edges);
+    UNUSED(xdg_toplevel);
     UNUSED(width);
     UNUSED(height);
+    UNUSED(states);
+    /* A zero width or height means "you choose", and any other size is
+     * a suggestion this surface cannot act on: libnsfb owns one
+     * fixed-size framebuffer for the life of the window, so honouring
+     * a resize would mean reallocating it under a NetSurf that has
+     * already been told how big its canvas is. Ignored deliberately,
+     * which is the same answer the wl_shell code gave. */
 }
 
 static void
-handle_popup_done(void *data, struct wl_shell_surface *shell_surface)
+handle_toplevel_close(void *data, struct xdg_toplevel *xdg_toplevel)
 {
-    UNUSED(data);
-    UNUSED(shell_surface);
+    struct wld_window *window = data;
+    struct wld_event *event;
+
+    UNUSED(xdg_toplevel);
+
+    /* The title bar's close button. Queued as NSFB_CONTROL_QUIT
+     * because that is precisely what the framebuffer frontend's event
+     * loop already checks for; without it the button does nothing and
+     * the only way out of the browser is the shell that started it. */
+    event = calloc(1, sizeof(*event));
+    if (event == NULL) {
+	return;
+    }
+    event->event.type = NSFB_EVENT_CONTROL;
+    event->event.value.controlcode = NSFB_CONTROL_QUIT;
+    enqueue_wld_event(window->connection, event);
 }
 
-static const struct wl_shell_surface_listener shell_surface_listener = {
-	handle_ping,
-	handle_configure,
-	handle_popup_done
+static const struct xdg_toplevel_listener xdg_toplevel_listener = {
+	handle_toplevel_configure,
+	handle_toplevel_close
 };
 
 static struct wld_window *
@@ -1403,23 +1470,40 @@
 	return NULL;
     }
 
-    window->shell_surface = wl_shell_get_shell_surface(connection->shell,
-						       window->surface);
-    if (window->shell_surface == NULL) {
-	fprintf(stderr, "failed to create shell surface\n");
-
+    window->xdg_surface = xdg_wm_base_get_xdg_surface(connection->wm_base,
+						     window->surface);
+    if (window->xdg_surface == NULL) {
+	fprintf(stderr, "failed to create xdg surface\n");
 	wl_surface_destroy(window->surface);
-
 	free(window);
 	return NULL;
     }
+    xdg_surface_add_listener(window->xdg_surface,
+			     &xdg_surface_listener, window);
 
-    wl_shell_surface_add_listener(window->shell_surface,
-				  &shell_surface_listener, window);
-
-    wl_shell_surface_set_title(window->shell_surface, "nsfb");
+    window->xdg_toplevel = xdg_surface_get_toplevel(window->xdg_surface);
+    if (window->xdg_toplevel == NULL) {
+	fprintf(stderr, "failed to create xdg toplevel\n");
+	xdg_surface_destroy(window->xdg_surface);
+	wl_surface_destroy(window->surface);
+	free(window);
+	return NULL;
+    }
+    xdg_toplevel_add_listener(window->xdg_toplevel,
+			      &xdg_toplevel_listener, window);
 
-    wl_shell_surface_set_toplevel(window->shell_surface);
+    xdg_toplevel_set_title(window->xdg_toplevel, "NetSurf");
+    /* The app id is what a taskbar groups by. novi-panel shows the
+     * title, but getting this right costs one call. */
+    xdg_toplevel_set_app_id(window->xdg_toplevel, "netsurf");
+
+    /* THE ORDER HERE IS THE PROTOCOL. Commit the surface with NO
+     * buffer, then round-trip: that asks the compositor for its
+     * initial configure, which handle_xdg_surface_configure() acks.
+     * Attaching a buffer first is an error and the surface never maps.
+     */
+    wl_surface_commit(window->surface);
+    wl_display_roundtrip(connection->display);
 
     return window;
 }
@@ -1428,7 +1512,10 @@
 free_window(struct wld_window *window)
 {
 
-    wl_shell_surface_destroy(window->shell_surface);
+    /* Toplevel before surface before wl_surface: destroying a role
+     * object after the thing it is a role for is a protocol error. */
+    xdg_toplevel_destroy(window->xdg_toplevel);
+    xdg_surface_destroy(window->xdg_surface);
     wl_surface_destroy(window->surface);
 
     free(window);
