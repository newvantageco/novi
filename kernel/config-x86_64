CONFIG_FAT_DEFAULT_UTF8=y
# Native Language Support, which on a FAT filesystem is not about
# language at all -- it is the character-set translation the driver
# needs before it can read a single long filename.
#
# CONFIG_FAT_DEFAULT_CODEPAGE is 437 whether or not anything provides
# codepage 437, and nothing here did: every NLS_* symbol was unset, so
# `mount -t vfat` failed with "Unable to load NLS charset cp437" and
# the EFI System Partition could not be mounted at all. That makes a
# UEFI install impossible (RFC 0008), and it had also been quietly
# breaking the initramfs's vfat fallback for live media.
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
